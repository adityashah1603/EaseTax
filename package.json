{
  "name": "easetax",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["shared", "server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=24" }
}
